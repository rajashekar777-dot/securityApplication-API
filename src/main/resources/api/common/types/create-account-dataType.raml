#%RAML 1.0 DataType 
type: object
properties:
  firstName:
    type: string
    required: true
    example: "raja"
  middleName:
    type: string
    required: true
    example: "shekar"
  lastName:
    type: string
    required: true
    example: "reddy"
  dateOfBirth:
    type: !include dob-dataType.raml
    required: true
  address:
    type: !include address-dataType.raml
    required: true
  contactDetails:
    type: !include contactDetails-dataType.raml
    required: true
  aadharNumber:
    type: !include aadhar-dataType.raml
    required: true
  panNumber:
    type: !include pan-number-dataType.raml
    required: true